{
  "name": "qualitygate-toolbox",
  "version": "0.1.0",
  "description": "Local quality gates for developers, CI and AI agents over MCP",
  "main": "dist/qualitygate.mjs",
  "scripts": {
    "start": "node dist/qualitygate.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages tests scripts --no-error-on-unmatched-pattern",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm analyze && pnpm test:coverage && pnpm build",
    "smoke": "node --import tsx scripts/smoke.ts",
    "fixture": "node --import tsx scripts/fixture.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:ci-templates": "node scripts/verify-ci-templates.mjs",
    "verify:clean": "node scripts/verify-clean.mjs",
    "test:coverage": "c8 --check-coverage node --experimental-test-module-mocks --import tsx --test tests/*.test.ts",
    "analyze": "node --import tsx packages/code-analysis/src/cli.ts",
    "smoke:dashboard": "node --import tsx scripts/dashboard-smoke.mjs",
    "verify:linux": "node scripts/linux/run.mjs",
    "verify:project": "node scripts/verify-project.mjs",
    "verify:analysis-package": "node scripts/verify-analysis-package.mjs",
    "dashboard": "node --import tsx packages/dashboard/src/cli.ts",
    "build:dashboard": "node packages/dashboard/build.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev:ui": "node --import tsx scripts/dashboard-portless.ts",
    "smoke:portless": "node scripts/portless-smoke.mjs",
    "verify:hooks": "node scripts/verify-hooks.mjs"
  },
  "author": "Nikolai Tatianenko",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "chrome-launcher": "1.0.0",
    "fast-xml-parser": "5.11.2",
    "lighthouse": "13.5.0",
    "yaml": "2.8.4",
    "zod": "3.25.76"
  },
  "bin": {
    "qualitygate": "dist/qualitygate.mjs"
  },
  "files": [
    "dist/*.mjs",
    "README.md",
    "LICENSE",
    "docs/PROTOTYPE.md",
    "VISION.md",
    "docs/VERIFICATION.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/demo",
    "examples/agent-fix",
    "docs/ARCHITECTURE.md",
    "docs/ENVIRONMENTS.md",
    "docs/INTEGRATIONS.md",
    "CHANGELOG.md",
    "docs/RELEASING.md",
    "docs/verification/*.json",
    "scripts/require-pnpm.mjs",
    "docs/CODE_QUALITY.md",
    "docs/SECURITY_REVIEW.md",
    "docs/CI.md",
    "examples/ci",
    "examples/security-review/.qualitygate.yml",
    "examples/security-review/qualitygate.sources.lock.json",
    "docs/PROJECT_SETUP.md",
    "examples/hooks",
    "docs/screenshots"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.28.9",
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "c8": "10.1.3",
    "esbuild": "0.25.10",
    "eslint": "9.37.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jsdom": "26.1.0",
    "portless": "0.12.0",
    "puppeteer-core": "24.43.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "keywords": [
    "quality-gates",
    "mcp",
    "lighthouse",
    "ci"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.9",
      "onFail": "error"
    }
  }
}
