{
  "name": "qualitygate-prototype",
  "version": "0.1.0",
  "description": "Local quality gates for developers, CI and AI agents over MCP",
  "main": "dist/qualitygate.mjs",
  "scripts": {
    "start": "node dist/qualitygate.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages tests scripts --no-error-on-unmatched-pattern",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node --import tsx scripts/smoke.ts",
    "fixture": "node --import tsx scripts/fixture.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:clean": "node scripts/verify-clean.mjs"
  },
  "author": "Nikolai Tatianenko",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "chrome-launcher": "1.0.0",
    "lighthouse": "12.8.2",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "bin": {
    "qualitygate": "dist/qualitygate.mjs"
  },
  "files": [
    "dist/*.mjs",
    "README.md",
    "LICENSE",
    "docs/PROTOTYPE.md",
    "VISION.md",
    "docs/VERIFICATION.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/demo",
    "examples/agent-fix"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.5.1",
  "devDependencies": {
    "@types/node": "22.18.6",
    "esbuild": "0.25.10",
    "eslint": "9.37.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "keywords": [
    "quality-gates",
    "mcp",
    "lighthouse",
    "ci"
  ]
}
